<UserControl x:Class="Xeno.VsLinuxDebug.OptionsPages.RemoteCredentialsOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Xeno.VsLinuxDebug.OptionsPages">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OptionsPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Style="{StaticResource PageRootStyle}">
    <GroupBox Header="Remote Credentials" Style="{StaticResource OptionsGroupBoxStyle}">
      <StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <Label Content="User Name" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}" Text="SSH User name on remote machine." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <CheckBox Content="SSH Key File Enabled"
                    IsChecked="{Binding UserPrivateKeyEnabled}"
                    Style="{StaticResource FieldCheckBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}" Text="Use SSH Key for connecting to remote machine." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource InverseBoolToVisibility}}">
          <Label Content="User Password" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}" Text="SSH Password on remote machine." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource BoolToVisibility}}">
          <Label Content="SSH Private Key File" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}" Text="Private key file." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource BoolToVisibility}}">
          <Label Content="SSH Private Key Password (optional)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPrivateKeyPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}" Text="Private key password (only if it was set)." />
        </StackPanel>

      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
