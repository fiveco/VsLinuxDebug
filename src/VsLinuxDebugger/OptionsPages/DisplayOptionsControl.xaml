<UserControl x:Class="Xeno.VsLinuxDebug.OptionsPages.DisplayOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OptionsPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Style="{StaticResource PageRootStyle}">
    <GroupBox Header="Remote X11 Display" Style="{StaticResource OptionsGroupBoxStyle}">
      <StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <CheckBox Content="Debug Display GUI"
                     IsChecked="{Binding RemoteDebugDisplayGui}"
                     Style="{StaticResource FieldCheckBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Display application on remote machine. This is helpful for debugging GUI applications on remote devices." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <Label Content="Remote X11 Display Number (optional)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding RemoteDebugDisplayNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Remote X11 Display number (only if it was set). Defaults to ':0'." />
        </StackPanel>

      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
