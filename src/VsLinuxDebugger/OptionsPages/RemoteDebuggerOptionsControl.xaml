<UserControl x:Class="Xeno.VsLinuxDebug.OptionsPages.RemoteDebuggerOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OptionsPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRootStyle}">
      <GroupBox Header="Remote Debugger" Style="{StaticResource OptionsGroupBoxStyle}">
        <StackPanel>

          <StackPanel Style="{StaticResource FieldRowStyle}">
            <Label Content="Upload to folder" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteDeployBasePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
            <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                       Text="Folder for to transfer files to. For HOME folder, use './VSLinuxDbg' and not '~/VSLinuxDbg'" />
          </StackPanel>

          <StackPanel Style="{StaticResource FieldRowStyle}">
            <Label Content=".NET executable" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteDotNetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
            <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                       Text="Path of the .NET executable on remote machine. (Samples: `dotnet`, `~/.dotnet/dotnet`)" />
          </StackPanel>

          <StackPanel Style="{StaticResource FieldRowStyle}">
            <Label Content="Visual Studio Debugger Path" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteVsDbgRootPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
            <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                       Text="Root folder of Visual Studio Debugger. (Samples: `~/.vs-debugger/`, `~/.vsdbg`)" />
          </StackPanel>

        </StackPanel>
      </GroupBox>

      <GroupBox Header="Remote X11 Display" Style="{StaticResource OptionsGroupBoxStyle}">
        <StackPanel>

          <StackPanel Style="{StaticResource FieldRowStyle}">
            <CheckBox Content="Debug Display GUI"
                      IsChecked="{Binding RemoteDebugDisplayGui}"
                      Style="{StaticResource FieldCheckBoxStyle}" />
            <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                       Text="Display application on remote machine. This is helpful for debugging GUI applications on remote devices." />
          </StackPanel>

          <StackPanel Style="{StaticResource FieldRowStyle}"
                      Visibility="{Binding RemoteDebugDisplayGui, Converter={StaticResource BoolToVisibility}}">
            <Label Content="Remote X11 Display Number (optional)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteDebugDisplayNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
            <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                       Text="Remote X11 Display number (only if it was set). Defaults to ':0'." />
          </StackPanel>

        </StackPanel>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
